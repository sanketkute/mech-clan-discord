# Copy this file to .env and fill it in. Never commit .env.
# Discord bot token, from the Discord Developer Portal (Bot page, Reset Token).
DISCORD_TOKEN=
# Your login at developer.clashofclans.com. The bot uses it to create an API key for this machine's IP,
# and makes a new one by itself when the IP changes.
COC_EMAIL=
COC_PASSWORD=
# Optional, on the laptop only: where the bot runs, so `mechbot` checks it there over SSH.
# BOT_SERVER=ubuntu@<server IP>
# BOT_SSH_KEY=C:\path\to\private.key
